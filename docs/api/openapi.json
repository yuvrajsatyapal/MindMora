    "/api/auth/logout": {
      "post": {
        "operationId": "authLogout",
        "summary": "Backend-owned auth logout",
        "description": "No caller-controlled redirect. Auth responses are no-store. Development verification only until Milestone 1D admission controls.",
        "security": [
          {
            "AppSession": []
          },
          {
            "LocalSession": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "description": "Must exactly match configured APP_ORIGIN.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Current provider session revoked and local cookies cleared; no cookie is idempotent. A provider outage is 503, never a claimed revocation.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
