{
  "openapi": "3.1.0",
  "info": {
    "title": "MindMora auth API",
    "version": "0.1.0",
    "description": "Milestone 1B auth-only contract. Bounded live Google/session/logout and refresh/replay acceptance recorded in docs/phases/phase-01-foundation.md. Notes, Swagger UI, Postman generation and full contract drift tooling are not implemented. 1D adds bounded empty-body checks, correlation IDs, Redis admission and safe Pino logging; hosted readiness remains unverified."
  },
  "paths": {
    "/api/auth/start": {
      "post": {
        "operationId": "authStart",
        "summary": "Backend-owned auth start",
        "description": "No caller-controlled redirect. Auth responses are no-store. 1D bounds empty bodies and applies Redis admission and Pino metadata. Hosted readiness remains unverified.",
        "security": [],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "description": "Must exactly match configured APP_ORIGIN.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to the configured Supabase Google authorize endpoint; writes protected pending cookie.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "const": "no-referrer"
                }
              },
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "Set-Cookie": {
                "description": "Host-only HttpOnly SameSite=Lax; Secure/__Host over HTTPS; no credential examples.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/CorrelationId"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            }
          },
          "400": {
            "description": "Safe auth error; raw provider errors and credentials are excluded.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "const": "no-referrer"
                }
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/CorrelationId"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "401": {
            "description": "Safe auth error; raw provider errors and credentials are excluded.",
