  "components": {
    "securitySchemes": {
      "AppSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-mindmora-session",
        "description": "Protected HTTPS app-session cookie; never copy credentials into docs."
      },
      "LocalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mindmora-session",
        "description": "Loopback HTTP development/preview exemption only."
      }
    },
    "schemas": {
      "SessionProjection": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "email": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "displayName": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "email",
              "displayName"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "AuthError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "correlationId"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "auth_unavailable",
                  "unauthenticated",
                  "origin_rejected",
                  "invalid_auth_request",
                  "invalid_auth_callback",
                  "method_not_allowed",
                  "invalid_request",
                  "payload_too_large",
                  "rate_limited",
                  "admission_unavailable",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string"
              },
              "correlationId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    },
    "headers": {
      "CorrelationId": {
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Server-generated request correlation ID."
      },
      "NoSniff": {
        "schema": {
          "type": "string",
          "const": "nosniff"
        }
      },
      "RetryAfter": {
        "schema": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "description": "Seconds until retry; present on admission rejections."
      }
    },
    "responses": {
      "BoundedRequest": {
        "description": "Request exceeds header, URL or body limits.",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "private, no-store"
            }
          },
          "Referrer-Policy": {
            "schema": {
              "type": "string",
              "const": "no-referrer"
            }
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/CorrelationId"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/NoSniff"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuthError"
            }
          }
        }
      },
      "AuthThrottled": {
        "description": "Auth admission budget exhausted.",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "private, no-store"
            }
          },
          "Referrer-Policy": {
            "schema": {
              "type": "string",
              "const": "no-referrer"
            }
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/CorrelationId"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/NoSniff"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuthError"
            }
          }
        }
      },
      "UnexpectedFailure": {
        "description": "Safe unexpected failure; no internal details.",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "private, no-store"
            }
          },
          "Referrer-Policy": {
            "schema": {
              "type": "string",
              "const": "no-referrer"
            }
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/CorrelationId"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/NoSniff"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuthError"
            }
          }
        }
      }
    }
  }
}
