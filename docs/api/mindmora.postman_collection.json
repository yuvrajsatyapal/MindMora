{
  "info": {
    "name": "MindMora auth, notes and knowledge",
    "description": "Disposable data only. Establish Google sign-in in the app. Keep cookies solely in a local Postman cookie jar; never export credentials. Callback placeholders are informational and cannot start a reusable session.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "noteId",
      "value": "00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "createKey",
      "value": "00000000-0000-4000-8000-000000000002"
    },
    {
      "key": "callbackCode",
      "value": ""
    },
    {
      "key": "callbackState",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "authStart",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/start/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"documented response status\", () => pm.expect([303,400,401,403,405,413,429,500,503]).to.include(pm.response.code));",
              "pm.test(\"private response is not cached\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "authCallback",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
