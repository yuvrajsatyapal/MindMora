{
  "name": "mindmora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint . && node scripts/check-styles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/test-showcase-e2e.mjs",
    "start": "next start",
    "test:boundary": "node scripts/test-server-boundary.mjs",
    "test:auth": "node --experimental-strip-types scripts/test-auth-e2e.mjs",
    "db:generate": "NODE_OPTIONS=--conditions=react-server drizzle-kit generate",
    "db:migrate": "node --env-file=.env --conditions=react-server --experimental-strip-types scripts/migrate-database.mjs",
    "db:provision": "node --env-file=.env --conditions=react-server --experimental-strip-types scripts/provision-database.mjs",
    "test:db": "node --conditions=react-server --experimental-strip-types scripts/test-database.mjs",
    "test:db:hosted": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.database.config.ts",
    "test:rate-limit": "node scripts/test-rate-limit.mjs",
    "test:startup": "node scripts/test-startup-health.mjs",
    "test:notes": "node scripts/test-notes-api.mjs",
    "api:generate": "node --experimental-strip-types scripts/generate-api-docs.mjs",
    "api:check": "node --experimental-strip-types scripts/generate-api-docs.mjs --check",
    "test:contract": "node --experimental-strip-types scripts/test-api-contract.mjs",
    "test:api-collection": "node --experimental-strip-types scripts/test-api-collection.mjs"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@supabase/auth-js": "2.117.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "dompurify": "3.4.16",
    "drizzle-orm": "0.45.3",
    "hast-util-to-jsx-runtime": "2.3.6",
    "katex": "0.19.0",
    "lucide-react": "1.51.0",
    "mermaid": "12.1.0",
    "next": "16.3.8",
    "nuqs": "2.10.1",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "swagger-ui-react": "5.33.1",
    "tailwindcss": "4.3.3",
    "unified": "11.0.5",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/swagger-ui-react": "5.18.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "type": "module",
  "overrides": {
    "esbuild": "0.28.2"
  }
}
