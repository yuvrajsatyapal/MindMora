# Optional for the public showcase. Required when a server consumer calls getServerConfig.
# Use the origin matching your local dev or preview address; no path, credentials or query.
APP_ORIGIN=http://localhost:3000
# For runtime preview use http://127.0.0.1:4173. Non-loopback hosts require HTTPS.
# Add service credentials only in their own milestones; never use NEXT_PUBLIC_ for secrets.

# Milestone 1B only: Supabase project URL and publishable key (not service-role/secret).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Google OAuth credentials must be configured in Supabase provider settings.

# Google OAuth setup reference only; the app does not read these values.
# Also enter them in Supabase Authentication > Providers > Google and enable Google.
# Keep the secret private; never use NEXT_PUBLIC_ or commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Milestone 1C: privileged migration URL (dev only) and constrained runtime URL.
# Copy MIGRATION_DATABASE_URL from Supabase Connect (session pooler for IPv4).
# Runtime DATABASE_URL must use the dedicated mindmora_app login, not postgres.
# TLS is required for non-loopback databases; never use NEXT_PUBLIC_ for these.
MIGRATION_DATABASE_URL=
DATABASE_URL=

# Verified TLS: path to the CA downloaded from Supabase Database SSL settings.
DATABASE_CA_CERT_PATH=prod-ca-2021.crt
DATABASE_POOL_MAX=3

# Milestone 1D: server-only Redis-compatible TCP endpoint. Remote requires verified TLS.
# Loopback plaintext is permitted only for local disposable development/tests.
REDIS_URL=redis://127.0.0.1:6379
# Keep none unless ingress overwrites X-Real-IP and direct access is blocked.
# With none, all public auth callers share per-action budgets.
TRUSTED_CLIENT_IP_HEADER=none

# Interactive API reference: development enabled; production disabled unless true.
# Public contract metadata only; all API requests still require normal auth/Origin checks.
API_DOCS_ENABLED=false
