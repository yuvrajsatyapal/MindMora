# Optional for the public showcase. Required when a server consumer calls getServerConfig.
# Use the origin matching your local dev or preview address; no path, credentials or query.
APP_ORIGIN=http://localhost:3000
# For runtime preview use http://127.0.0.1:4173. Non-loopback hosts require HTTPS.
# Add service credentials only in their own milestones; never use NEXT_PUBLIC_ for secrets.

# Milestone 1B only: Supabase project URL and publishable key (not service-role/secret).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Google OAuth credentials must be configured in Supabase provider settings.

# Google OAuth setup reference only; the app does not read these values.
# Also enter them in Supabase Authentication > Providers > Google and enable Google.
# Keep the secret private; never use NEXT_PUBLIC_ or commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
